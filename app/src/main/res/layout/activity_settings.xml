<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/module_description"
            android:textSize="13sp" />

        <!-- ==================== 总开关 ==================== -->

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_general" />

        <Switch
            android:id="@+id/sw_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_enabled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/label_alpha" />

        <TextView
            android:id="@+id/tv_alpha_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- ==================== 作用范围 ==================== -->

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_targets" />

        <CheckBox
            android:id="@+id/cb_right_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_right_column" />

        <CheckBox
            android:id="@+id/cb_bottom_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_bottom_caption" />

        <CheckBox
            android:id="@+id/cb_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_disclaimer" />

        <CheckBox
            android:id="@+id/cb_bottom_hot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_bottom_hot" />

        <CheckBox
            android:id="@+id/cb_pendant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_pendant" />

        <CheckBox
            android:id="@+id/cb_contain_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_contain_video" />

        <CheckBox
            android:id="@+id/cb_auto_skip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_auto_skip_unmatched" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/label_auto_skip_delay" />

        <TextView
            android:id="@+id/tv_auto_skip_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek_auto_skip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/cb_kill_double_tap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_kill_double_tap" />

        <CheckBox
            android:id="@+id/cb_pin_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_pin_search" />

        <!-- ==================== 提示 ==================== -->

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_hint" />

        <TextView
            style="@style/HintText"
            android:text="@string/hint_enable_module" />

        <TextView
            style="@style/HintText"
            android:text="@string/hint_restart" />

        <TextView
            style="@style/HintText"
            android:text="@string/hint_scope" />

    </LinearLayout>
</ScrollView>
